# RuTeR runtime configuration (environment layer)
# Priority: CLI > ENV > ruter.toml > defaults

RUTER_TOPK_SIZE=3

RUTER_LLM_ENABLED=false
RUTER_LLM_MODE=replay
RUTER_LLM_REPLAY_FILE=

# Online mode settings
RUTER_LLM_API_URL=https://api.openai.com/v1
RUTER_LLM_MODEL=gpt-4o-mini
RUTER_LLM_API_KEY=

RUTER_LLM_TIMEOUT_SECS=60
RUTER_LLM_MAX_ROUNDS=3
RUTER_LLM_MAX_CANDIDATES_PER_ROUND=3
RUTER_LLM_OUTPUT_TOKEN_RATIO=2.0
RUTER_LLM_CONTEXT_MAX_CHARS=12000
RUTER_LLM_TARGET_FN_HARD_LIMIT_CHARS=8000
RUTER_LLM_RAW_EXCERPT_MAX_CHARS=4096
RUTER_LLM_DEBUG_DUMP_FULL_IO=false
